{
  "name": "plasgos-webchat-widget",
  "private": true,
  "description": "Widget webchat Plasgos CRM: loader, aplikasi widget (iframe), paket npm, dan wrapper framework.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build && node scripts/build-fixtures.mjs",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e/tsconfig.json --noEmit && tsc -p e2e-live/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p fixtures/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node scripts/size-budget.mjs",
    "e2e": "playwright test",
    "perf": "node scripts/lighthouse-compare.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm e2e",
    "e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "1.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "lit": "3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dom18": "npm:react-dom@^18.3.1",
    "react18": "npm:react@^18.3.1",
    "rxjs": "7.8.2",
    "solid-js": "1.9.17",
    "svelte": "^5.57.2",
    "svelte-check": "4.7.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zone.js": "0.16.3"
  }
}
