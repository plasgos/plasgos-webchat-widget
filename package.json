{
  "name": "plasgos-webchat-widget",
  "private": true,
  "description": "Widget webchat Plasgos CRM: loader, aplikasi widget (iframe), paket npm, dan wrapper framework.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e/tsconfig.json --noEmit && tsc -p e2e-live/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node scripts/size-budget.mjs",
    "e2e": "playwright test",
    "perf": "node scripts/lighthouse-compare.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm e2e",
    "e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "chrome-launcher": "1.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
