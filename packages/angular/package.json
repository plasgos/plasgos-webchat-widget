{
  "name": "@plasgos/webchat-angular",
  "version": "1.0.0",
  "description": "Provider & service Angular 17+ (standalone, SSR, zoneless) untuk widget webchat Plasgos CRM.",
  "keywords": ["plasgos", "crm", "webchat", "chat", "widget", "angular"],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Plasgos",
  "homepage": "https://github.com/plasgos/plasgos-webchat-widget/tree/main/packages/angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasgos/plasgos-webchat-widget.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plasgos/webchat": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@angular/router": ">=17"
  },
  "peerDependenciesMeta": {
    "@angular/router": { "optional": true }
  }
}
