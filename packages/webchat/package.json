{
  "name": "@plasgos/webchat",
  "version": "1.0.2",
  "description": "Widget webchat Plasgos CRM untuk aplikasi berbundler (Vite, webpack, Next, Nuxt, Angular, SvelteKit, Astro, Remix). Aman SSR.",
  "keywords": [
    "plasgos",
    "crm",
    "webchat",
    "chat",
    "widget",
    "live-chat"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Plasgos",
  "homepage": "https://github.com/plasgos/plasgos-webchat-widget/tree/main/packages/webchat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasgos/plasgos-webchat-widget.git",
    "directory": "packages/webchat"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./src/element.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node build-cdn.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke-consume.mjs"
  }
}
