{
  "name": "@plasgos/webchat-vue",
  "version": "0.1.0",
  "description": "Plugin & composable Vue 3 untuk widget webchat Plasgos CRM (Vue Router, Nuxt 3 `.client`). Aman SSR.",
  "keywords": ["plasgos", "crm", "webchat", "chat", "widget", "vue", "nuxt"],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Plasgos",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plasgos/webchat": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.2 <4"
  }
}
